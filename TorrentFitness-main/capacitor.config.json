{
  "appId": "com.torrentfitness.app",
  "appName": "Torrent Fitness",
  "webDir": "dist",
  "android": {
    "buildOptions": {
      "keystorePath": "release.keystore",
      "keystoreAlias": "torrentfitness"
    },
    "allowMixedContent": true
  },
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "*.razorpay.com",
      "api.razorpay.com",
      "checkout.razorpay.com",
      "*.firebaseio.com",
      "*.googleapis.com"
    ]
  }
}
