# -------------------------------------------------------------
# Torrent Fitness — Production Environment Configuration
# -------------------------------------------------------------

# Server Runtime
NODE_ENV="production"
PORT=3000

# Security: Cryptographic Secret for Server-Signed Session Tokens (HMAC-SHA256)
# Generate with: npm run generate-secret
SESSION_SECRET="replace_with_a_secure_64_byte_random_hex_string"

# Admin Setup: Initial master admin password (can be changed in the admin dashboard)
ADMIN_DEFAULT_PASSWORD="replace_with_strong_initial_admin_password"

# Application URL (Used for self-referential links, OAuth callbacks, and payment gateways)
APP_URL="http://localhost:3000"

# Gemini AI API Key (Required for AI Physique Analysis via Gemini Vision)
GEMINI_API_KEY=""

# Firebase Client Configuration (Optional overrides; falls back to firebase-applet-config.json)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
