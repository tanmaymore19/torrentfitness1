rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: {userId}
// Fields:
//   - uid: string (required) - unique user ID matching document ID
//   - username: string (required) - unique login identifier
//   - displayName: string (optional) - display name
//   - email: string (optional) - email address
//   - phone: string (optional) - contact phone number
//   - role: string (required, 'client' | 'trainer' | 'admin') - account role
//   - status: string (required, 'active' | 'pending' | 'rejected') - account status
//   - photoUrl: string (optional) - profile photo URL
//   - createdAt: string (optional) - ISO 8601 creation timestamp
//
// Collection: members
// Document ID: {memberId}
// Fields:
//   - Client/Member records mirrored for gym management and directory lookups
//
// Collection: trainers
// Document ID: {trainerId}
// Fields:
//   - Trainer roster records and administrative management data
//
// Collection: clientProfiles
// Document ID: {userId}
// Fields:
//   - Detailed member/client health and gym profiles
//
// Collection: trainerProfiles
// Document ID: {trainerId}
// Fields:
//   - Detailed trainer specializations and client rosters
//
// Collection: usernames
// Document ID: {username}
// Fields:
//   - uid: string - linked user ID
//   - username: string - unique registered handle
//
// Collection: deleted_users
// Document ID: {docId}
// Fields:
//   - Audit trail and tombstone records for permanently deleted users
//
// Collection: gym_settings / gymSettings
// Document ID: {settingsId}
// Fields:
//   - Gym operating configuration, categories, and business settings
//
// Collection: gym_config / gymQrConfig
// Document ID: {configId}
// Fields:
//   - Realtime gym QR configurations and payment gateway credentials
//
// Collection: pt_requests / ptRequests
// Document ID: {requestId}
// Fields:
//   - Personal training requests, bookings, and assignment status
//
// Collection: pt_chats
// Document ID: {chatId}
// Subcollections:
//   - {document=**} (chat messages and direct communications)
// Fields:
//   - Direct chat threads between clients and personal trainers
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Check if user is authenticated via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Identifies protected Master Admin / Owner accounts to prevent accidental or malicious deletion
    // Strictly safeguards 'admin', 'admintorrentfitness1', and 'admin_master_1' as well as any account with role == 'admin'
    // Performs safe null-checks on resource and resource.data before inspecting resource.data.role
    function isMasterAdmin(userId) {
      return userId in ['admin', 'admintorrentfitness1', 'admin_master_1'] ||
             (resource != null && resource.data != null && ('role' in resource.data) && resource.data.role == 'admin');
    }

    // ==========================================
    // USER ACCOUNTS & PRIVILEGE ESCALATION SHIELD
    // ==========================================
    // Allows user registration for client and trainer accounts.
    // Strictly prevents client/trainer self-escalation to 'admin'.
    // Permits delete operations for client and trainer user documents
    // while permanently protecting Master Admin accounts from deletion.
    match /users/{userId} {
      allow read: if true;
      allow create: if request.resource.data.role in ['client', 'trainer'];
      allow update: if ('role' in resource.data && request.resource.data.role == resource.data.role) || (request.resource.data.role in ['client', 'trainer']);
      allow delete: if !isMasterAdmin(userId);
    }

    // ==========================================
    // USER ALIASES, DIRECTORIES & AUDIT COLLECTIONS
    // ==========================================
    match /members/{memberId} {
      allow read, write: if true;
    }

    match /trainers/{trainerId} {
      allow read, write: if true;
    }

    match /usernames/{username} {
      allow read, write: if true;
    }

    match /deleted_users/{docId} {
      allow read, write: if true;
    }

    // ==========================================
    // PROFILES
    // ==========================================
    match /clientProfiles/{userId} {
      allow read, write: if true;
    }

    match /trainerProfiles/{trainerId} {
      allow read, write: if true;
    }

    // ==========================================
    // GYM CONFIGURATION & SETTINGS COLLECTIONS
    // ==========================================
    match /gym_settings/{settingsId} {
      allow read, write: if true;
    }

    match /gymSettings/{settingsId} {
      allow read, write: if true;
    }

    match /gym_config/{configId} {
      allow read, write: if true;
    }

    match /gymQrConfig/{configId} {
      allow read, write: if true;
    }

    // ==========================================
    // GYM OPERATIONS & MANAGEMENT COLLECTIONS
    // ==========================================
    match /membershipPlans/{planId} {
      allow read, write: if true;
    }

    match /membership_plans/{planId} {
      allow read, write: if true;
    }

    match /plans/{planId} {
      allow read, write: if true;
    }

    match /memberships/{membershipId} {
      allow read, write: if true;
    }

    match /workouts/{workoutId} {
      allow read, write: if true;
    }

    match /workout_library/{workoutId} {
      allow read, write: if true;
    }

    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    match /events/{eventId} {
      allow read, write: if true;
    }

    match /eventRegistrations/{regId} {
      allow read, write: if true;
    }

    match /challenges/{challengeId} {
      allow read, write: if true;
    }

    match /challengeParticipations/{partId} {
      allow read, write: if true;
    }

    match /offers/{offerId} {
      allow read, write: if true;
    }

    match /popups/{popupId} {
      allow read, write: if true;
    }

    match /promoBanners/{bannerId} {
      allow read, write: if true;
    }

    match /gymPhotos/{photoId} {
      allow read, write: if true;
    }

    match /facilities/{facilityId} {
      allow read, write: if true;
    }

    match /aerobicsRoutines/{routineId} {
      allow read, write: if true;
    }

    match /aerobicsBatches/{batchId} {
      allow read, write: if true;
    }

    match /aerobicsLogs/{logId} {
      allow read, write: if true;
    }

    match /aerobicsSubscriptions/{subId} {
      allow read, write: if true;
    }

    match /paymentGateways/{gatewayId} {
      allow read, write: if true;
    }

    match /paymentTransactions/{transactionId} {
      allow read, write: if true;
    }

    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    match /payments/{paymentId} {
      allow read, write: if true;
    }

    match /invoices/{invoiceId} {
      allow read, write: if true;
    }

    match /billing_history/{historyId} {
      allow read, write: if true;
    }

    match /attendance/{attendanceId} {
      allow read, write: if true;
    }

    match /attendance_logs/{logId} {
      allow read, write: if true;
    }

    match /fitnessAnalysisHistory/{analysisId} {
      allow read, write: if true;
    }

    match /ptRequests/{requestId} {
      allow read, write: if true;
    }

    match /pt_requests/{requestId} {
      allow read, write: if true;
    }

    match /pt_chats/{chatId} {
      allow read, write: if true;
    }

    match /pt_chats/{chatId}/{document=**} {
      allow read, write: if true;
    }

    match /ptSchedules/{scheduleId} {
      allow read, write: if true;
    }

    match /ptPlans/{planId} {
      allow read, write: if true;
    }

    match /dietPlans/{dietPlanId} {
      allow read, write: if true;
    }

    match /feedback/{feedbackId} {
      allow read, write: if true;
    }

    match /directMessages/{messageId} {
      allow read, write: if true;
    }

    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
